---
import type { CollectionEntry } from 'astro:content';
import Layout from '~/layouts/PageLayout.astro';
import Image from '~/components/common/Image.astro';
import ContactUs from '~/components/widgets/Service.astro';
import FAQ from '~/components/widgets/FAQ.astro';
import ServiceRelatedPosts from '~/components/widgets/ServiceRelatedPosts.astro';
import {
  buildLanguageAlternatesForLangs,
  DEFAULT_SEO_LANG,
  getAlternateOgLocalesForLangs,
  stripLangPrefix,
} from '~/data/seo';

export interface Props {
  entry: CollectionEntry<'practiceArea'>;
  lang: string;
  availableLangs: string[];
}

const { entry, lang, availableLangs } = Astro.props;
const { metadata, seo, post, contactForm, hero, faq } = entry.data;
const postImageSrc = typeof post.image === 'string' ? post.image : post.image?.src;
const serviceSlug = entry.id.split('/').pop() ?? '';
const pinnedPosts = seo?.strategy?.internalLinks ?? [];

const siteUrl = String(Astro.site ?? 'https://capitollawpartners.com');
const { routePath } = stripLangPrefix(Astro.url.pathname, DEFAULT_SEO_LANG);
const languageAlternates = buildLanguageAlternatesForLangs(routePath, siteUrl, availableLangs, DEFAULT_SEO_LANG, true);
const ogLocaleAlternates = getAlternateOgLocalesForLangs(lang, availableLangs, true);
---

<Layout
  metadata={metadata}
  seo={seo}
  faq={faq}
  languageAlternates={languageAlternates}
  ogLocaleAlternates={ogLocaleAlternates}
>
  <section class="py-2 sm:py-6 lg:py-8 mx-auto">
    {
      contactForm && (
        <ContactUs
          id="form"
          title={contactForm.title}
          infoTitle={contactForm.infoTitle ?? contactForm.title}
          infoDescription={contactForm.infoDescription ?? contactForm.subtitle}
          googleReview={contactForm.googleReview}
          inputs={[
            { type: 'text', name: 'name', label: contactForm.inputs?.name },
            { type: 'email', name: 'email', label: contactForm.inputs?.email },
            { type: 'tel', name: 'phone', label: contactForm.inputs?.phone },
          ]}
          textarea={{ label: contactForm.textarea }}
          disclaimer={{ label: contactForm.disclaimer }}
          image={hero?.image}
          readMoreHref="#overview"
        />
      )
    }
    <article id="overview" class="scroll-mt-32">
      <header class="intersect-once motion-safe:md:opacity-0 motion-safe:md:intersect:animate-fade">
        <h1
          class="px-4 sm:px-6 max-w-3xl mb-10 mt-4 sm:mt-10 mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
        >
          {post.title}
        </h1>
        <p class="max-w-3xl mx-auto mt-1 mb-2 px-4 sm:px-6 text-xl md:text-2xl text-muted text-justify"></p>

        {
          postImageSrc ? (
            <Image
              src={postImageSrc}
              class="max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400"
              widths={[400, 900]}
              sizes="(max-width: 900px) 400px, 900px"
              alt=""
              width={900}
              height={506}
              loading="eager"
              decoding="async"
            />
          ) : (
            <div class="max-w-3xl mx-auto px-4 sm:px-6">
              <div class="border-t" />
            </div>
          )
        }
      </header>
      <div
        class="mx-auto px-6 sm:px-6 max-w-3xl prose prose-md lg:prose-xl prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
      >
        <Fragment set:html={post.content} />
      </div>
      {faq && faq.length > 0 && <FAQ items={faq} lang={lang} />}
    </article>
    <ServiceRelatedPosts slug={serviceSlug} lang={lang} pinned={pinnedPosts} />
  </section>
</Layout>
