---
import { ANALYTICS } from 'astrowind:config';

// Phone and WhatsApp clicks go to GA4 (phone_call_click / whatsapp_click) and to Meta as the standard Contact event.
const enabled = !!ANALYTICS?.vendors?.googleAnalytics?.id || !!ANALYTICS?.vendors?.metaPixel?.id;
---

{
  enabled && (
    <script>
      document.addEventListener('click', (event) => {
        const link = event.target instanceof Element ? event.target.closest('a[href]') : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        type Tracker = ((...args: unknown[]) => void) | undefined;
        const gtag = (window as unknown as { gtag?: Tracker }).gtag;
        const fbq = (window as unknown as { fbq?: Tracker }).fbq;
        const ga = (name: string, params: Record<string, string>) => {
          if (typeof gtag === 'function') gtag('event', name, params);
        };
        const meta = (channel: string) => {
          if (typeof fbq === 'function') fbq('track', 'Contact', { content_name: channel });
        };

        const href = link.getAttribute('href') ?? '';

        if (link.hasAttribute('data-analytics-announcement-phone') && href.startsWith('tel:')) {
          ga('phone_call_click', { phone_number: href.replace(/^tel:/i, ''), source_component: 'announcement_bar' });
          meta('phone');
        } else if (link.hasAttribute('data-analytics-whatsapp')) {
          ga('whatsapp_click', { link_url: href, source_component: 'chat_button' });
          meta('whatsapp');
        }
      });
    </script>
  )
}
