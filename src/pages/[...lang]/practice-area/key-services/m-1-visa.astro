---
import ServicePage from '~/components/widgets/ServicePage.astro';
import { getServiceStaticPaths, type ServicePageProps } from '~/utils/servicePages';

// One route per language that has a content file for this service
// (src/content/practiceArea/<language>/m-1-visa.md).
export async function getStaticPaths() {
  return getServiceStaticPaths('m-1-visa');
}

const { entry, lang, availableLangs } = Astro.props as ServicePageProps;
---

<ServicePage entry={entry} lang={lang} availableLangs={availableLangs} />
