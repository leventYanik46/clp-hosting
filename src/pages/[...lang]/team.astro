---
import Layout from '~/layouts/PageLayout.astro';
import TeamCard from '~/components/widgets/teamcard.astro';
import { getListPage } from "~/utils/lib/contentParser.astro";
import { supportedLang } from "~/utils/lib/languageParser";

export function getStaticPaths() {
  const paths = supportedLang.map((lang) => ({
    params: { lang: lang || undefined },
  }));
  return paths;
}

const { lang } = Astro.params;

const teampage = await getListPage("team", lang);
if (!teampage || teampage.length === 0 || !teampage[0].data) {
  throw new Error("Team content not found for language: " + lang);
}

const { heading, metadata, seo, sections } = teampage[0].data;
const pageHeading = heading ?? metadata?.title ?? seo?.title;
const filteredSections =
  sections?.filter((section) => section.wrapper?.trim() !== 'w-full grid grid-cols-1 md:grid-cols-3 gap-4') ?? [];

const isTwoColumnTeamSection = (wrapper?: string) => wrapper?.includes('md:grid-cols-2');
---

<Layout metadata={metadata} seo={seo}>
  {pageHeading && (
    <section class="mx-auto max-w-6xl px-4 sm:px-6 pt-10 md:pt-16 pb-8 md:pb-12">
      <h1 class="text-center text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading">{pageHeading}</h1>
      <div class="mx-auto mt-2.5 h-1 w-16 rounded-full bg-primary" aria-hidden="true"></div>
    </section>
  )}

  {filteredSections.map((section) => {
    const shouldCenterLastCard =
      isTwoColumnTeamSection(section.wrapper) && section.members.length % 2 === 1;

    return (
      <>
      {section.heading && (
        <div class="mx-auto max-w-6xl px-4 sm:px-6 mt-20 md:mt-28 mb-10 md:mb-14 text-center">
          <h2 class="text-3xl md:text-4xl font-bold leading-tighter tracking-tighter font-heading">{section.heading}</h2>
          <div class="mx-auto mt-2.5 h-1 w-16 rounded-full bg-primary" aria-hidden="true"></div>
        </div>
      )}
      <div class={section.wrapper}>
        {section.members.map((member, index) => {
          const isCenteredLastCard = shouldCenterLastCard && index === section.members.length - 1;

          return (
            <div class:list={[isCenteredLastCard && 'md:col-span-2', isCenteredLastCard && 'flex justify-center']}>
              <TeamCard {...(member as any)} />
            </div>
          );
        })}
      </div>
      </>
    );
  })}
</Layout>
